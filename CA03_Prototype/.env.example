# Example environment variables.
# For this prototype the values below are already hard-coded as safe
# development defaults inside docker-compose.yml, so a .env file is optional.
# Copy this file to .env and change the values for a real deployment.

# Shared secret used by the Auth Service to sign JWTs and by the
# API Gateway to verify them. MUST be identical in both.
JWT_SECRET=mediconnect_dev_secret
